# Copy this file to .env.local and fill in what you need. .env.local is git-ignored.
# You can run the Replay dashboard with NOTHING set. Each block below unlocks more.

# ---------------------------------------------------------------------------
# Accounts: Sign in with GitHub + saved projects (needed for Connect, Agent, Live)
# ---------------------------------------------------------------------------
# MongoDB (Atlas free tier is fine). Stores users and their ENCRYPTED saved projects.
# In Atlas, Network Access must allow the machine that runs the server.
MONGODB_URI=
# MONGODB_DB=verdict
# GitHub OAuth App: github.com/settings/developers, New OAuth App.
#   Homepage URL: http://localhost:3000
#   Callback URL: http://localhost:3000/api/auth/github/callback  (add your deployed URL too)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Encrypts saved keys and signs the login cookie. REQUIRED in production.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VERDICT_SECRET=

# ---------------------------------------------------------------------------
# 1. Live dashboard and the agent: Flagsmith
# ---------------------------------------------------------------------------
# Organisation API key: Flagsmith > Organisation settings > API Access > Create API Key.
FLAGSMITH_API_KEY=
# "Api-Key" for an Organisation key (default). Use "Token" for a personal account token.
FLAGSMITH_AUTH_SCHEME=Api-Key
# Client-side environment key: Flagsmith > your project > SDK Keys.
FLAGSMITH_ENVIRONMENT_KEY=
# The number in your Flagsmith project URL: app.flagsmith.com/project/<this>/...
FLAGSMITH_PROJECT_ID=
# Optional: pin the experiment the live dashboard opens with. Default: the first one.
FLAGSMITH_EXPERIMENT_ID=

# ---------------------------------------------------------------------------
# 2. The /demo page (a browser app that sends real exposures and clicks)
# ---------------------------------------------------------------------------
# The same client-side key as above. Client keys are public by design.
NEXT_PUBLIC_FLAGSMITH_ENVIRONMENT_KEY=

# ---------------------------------------------------------------------------
# 3. The agent's language model
# ---------------------------------------------------------------------------
# Default provider is Gemini (free tier). Get a key at aistudio.google.com.
GEMINI_API_KEY=
# Optional. Run `npx tsx --env-file=.env.local scripts/list-gemini-models.ts` to see what your key can use.
# GEMINI_MODEL=gemini-3.5-flash-lite
# To use Claude instead: AGENT_PROVIDER=anthropic and set ANTHROPIC_API_KEY (billed separately from a Claude chat plan).
# AGENT_PROVIDER=gemini
# ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# 4. Cleanup pull requests (optional; without these the agent shows the diff instead)
# ---------------------------------------------------------------------------
# A fine-grained token limited to ONE repo, with Contents and Pull requests set to read and write.
GITHUB_TOKEN=
# owner/name
GITHUB_REPO=

# ---------------------------------------------------------------------------
# Other
# ---------------------------------------------------------------------------
# Verdict labels live traffic as SIMULATED unless you set this to 1 (only do that for real users).
# VERDICT_TRAFFIC_IS_REAL=1

# Folder the agent may edit when it opens a cleanup pull request. Default: app/demo/
# (People who use the Connect page set their own folder there.)
# VERDICT_CLEANUP_PATH=src/components

# Lets remote visitors use THIS server's keys. Single-owner use only. Never set this
# on a deployment other people can reach.
# VERDICT_ALLOW_REMOTE=1

# Leave unset to let everyone use the agent with THIS server's GEMINI_API_KEY when they have no key of their own.
# Set to 1 to make everyone bring their own key (protects your free-tier quota on a public deployment).
# VERDICT_DISABLE_SHARED_MODEL=1
